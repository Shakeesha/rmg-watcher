# Pipeline
PIPELINE_MOCK_MODE=false
DATABASE_PATH=data/transit.db
RAW_STORE_PATH=data/raw
QUARANTINE_PATH=data/quarantine
LOG_LEVEL=INFO

# Live transit API
TRANSIT_API_BASE_URL=https://example.invalid/api
TRANSIT_API_KEY=

# API server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_DIST_PATH=frontend/dist

# Kiosk browser (deploy/scripts/start-kiosk.sh)
KIOSK_URL=http://127.0.0.1:8000/
# KIOSK_DISPLAY_SERVER=auto          # auto | wayland | x11
# KIOSK_BROWSER=chromium             # chromium | chromium-browser | google-chrome
KIOSK_RESTART_DELAY=3

# GPIO navigation uses BCM pins 17, 27, 22, 23, and 24 by default.
# See deploy/scripts/gpio_to_keys.py for the key mapping.
