# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------

# true | false — use bundled fixtures instead of the live API.
# Tests always force this to true.
# Default: false.
PIPELINE_MOCK_MODE=false

# Writable path to the SQLite database file.
# Default: data/transit.db.
DATABASE_PATH=data/transit.db

# Writable directory for immutable raw JSON snapshots.
# Default: data/raw.
RAW_STORE_PATH=data/raw

# Writable directory for rejected records.
# Default: data/quarantine.
QUARANTINE_PATH=data/quarantine

# CRITICAL | ERROR | WARNING | INFO | DEBUG — log verbosity.
# Default: INFO.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Live data provider
# ---------------------------------------------------------------------------

# transitous | generic — live backend implementation.
# Default: transitous.
TRANSIT_PROVIDER=transitous

# Email address or project URL. Required by Transitous usage policy in live
# mode; sent in the User-Agent header. Leave empty only in mock mode.
TRANSIT_CONTACT=

# HTTP(S) URL of the Transitous MOTIS API root.
# Default: https://api.transitous.org/api
TRANSITOUS_BASE_URL=https://api.transitous.org/api

# Bounding box lower-right corner as "latitude,longitude".
# Default: 49.80,9.00 — covers the Darmstadt-Dieburg area.
TRANSITOUS_AREA_MIN=49.80,9.00

# Bounding box upper-left corner as "latitude,longitude".
# Default: 50.02,8.55.
TRANSITOUS_AREA_MAX=50.02,8.55

# Comma-separated Transitous stop IDs polled in the background.
# Empty (default) means no stops are polled; the UI suggests nearby stops instead.
TRANSITOUS_WATCH_STOPS=

# -90.0 to 90.0 — latitude used to suggest nearby stops on first load.
# Default: 49.872881 — Darmstadt Luisenplatz.
TRANSITOUS_HOME_LAT=49.872881

# -180.0 to 180.0 — longitude used to suggest nearby stops on first load.
# Default: 8.651252 — Darmstadt Luisenplatz.
TRANSITOUS_HOME_LON=8.651252

# 100 to 10000 metres — radius for the initial nearby-stop suggestions.
# Default: 1500.
TRANSITOUS_SUGGESTED_RADIUS_M=1500

# 1 to 20 — maximum nearby stops suggested on first load.
# Default: 3.
TRANSITOUS_SUGGESTED_LIMIT=3

# 1 to 10 — number of nearby stops checked for service alerts.
# Default: 3.
TRANSITOUS_ALERT_STOPS=3

# 1 to 10 — maximum autocomplete results from the geocoder.
# Default: 6.
TRANSITOUS_GEOCODE_LIMIT=6

# Path to the generated static German stop catalog JSON file.
# Default: data/german-stops.json. Generate with `npm run build:stops`.
GERMAN_STOPS_PATH=data/german-stops.json

# 1 to 100 — next departures/arrivals requested per stop.
# Default: 20.
TRANSITOUS_DEPARTURE_LIMIT=20

# >= 60 seconds — minimum age between cached departure refreshes per stop.
# Default: 600 (10 minutes), about 432 requests/day for three watched stops.
TRANSITOUS_MIN_REFRESH_SECONDS=600

# 1 to 200 — daily cap on fresh /v6/plan connection searches.
# Default: 30.
TRANSITOUS_PLAN_LIMIT_PER_DAY=30

# 1 to 240 minutes — cache lifetime for connection search results.
# Default: 30.
TRANSITOUS_PLAN_CACHE_MINUTES=30

# 50 to 5000 metres — radius for the Nearby button.
# Default: 1000.
TRANSITOUS_NEARBY_RADIUS_M=1000

# 1 to 20 — maximum stops shown by the Nearby button.
# Default: 3.
TRANSITOUS_NEARBY_LIMIT=3

# Writable directory for cached catalog, departures, alerts, and geocoding.
# Default: data/transitous.
TRANSITOUS_CACHE_PATH=data/transitous

# HTTP(S) URL for the generic REST client. Only used when
# TRANSIT_PROVIDER=generic. Default: https://example.invalid/api.
TRANSIT_API_BASE_URL=https://example.invalid/api

# API key string for the generic REST client; empty means none.
# Only used when TRANSIT_PROVIDER=generic.
TRANSIT_API_KEY=

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# Host/interface to bind: 0.0.0.0 (all interfaces) or 127.0.0.1 (local only).
# Default: 0.0.0.0.
API_HOST=0.0.0.0

# 1 to 65535 — TCP port for the API and kiosk UI.
# Default: 8000.
API_PORT=8000

# Path to the Vite build output served by FastAPI.
# Default: frontend/dist.
FRONTEND_DIST_PATH=frontend/dist

# ---------------------------------------------------------------------------
# Kiosk browser (deploy/scripts/start-kiosk.sh)
# ---------------------------------------------------------------------------

# HTTP(S) URL opened fullscreen by the kiosk browser.
# Default: http://127.0.0.1:8000/
KIOSK_URL=http://127.0.0.1:8000/

# HTTP(S) URL polled until the API is ready.
# Default: http://127.0.0.1:8000/api/health
KIOSK_API_URL=http://127.0.0.1:8000/api/health

# auto | wayland | x11 — display backend.
# Default: auto.
KIOSK_DISPLAY_SERVER=auto

# chromium | chromium-browser | google-chrome — browser binary.
# Default: chromium.
KIOSK_BROWSER=chromium

# >= 0 seconds — delay before restarting a crashed browser.
# Default: 3.
KIOSK_RESTART_DELAY=3

# >= 1 — number of one-second attempts to wait for the API/compositor.
# Default: 60.
KIOSK_READY_ATTEMPTS=60
