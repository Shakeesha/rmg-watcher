# Pipeline
PIPELINE_MOCK_MODE=false
DATABASE_PATH=data/transit.db
RAW_STORE_PATH=data/raw
QUARANTINE_PATH=data/quarantine
LOG_LEVEL=INFO

# Live data provider: transitous (default) or generic
TRANSIT_PROVIDER=transitous

# Transitous MOTIS API (https://transitous.org/api/)
# Required by their usage policy: an email address or project URL.
TRANSIT_CONTACT=
TRANSITOUS_BASE_URL=https://api.transitous.org/api
TRANSITOUS_AREA_MIN=49.80,9.00
TRANSITOUS_AREA_MAX=50.02,8.55
# Comma-separated stop IDs. Keep this list short; each stop costs one
# cached request per refresh interval.
TRANSITOUS_WATCH_STOPS=de-DELFI_de:06411:4734,de-amarillo-bw_de:06411:4736,de-DELFI_de:06432:8563
TRANSITOUS_DEPARTURE_LIMIT=20
# 420s = 7 minutes: about 432 departure requests/day for three stops.
TRANSITOUS_MIN_REFRESH_SECONDS=420
TRANSITOUS_NEARBY_RADIUS_M=1000
TRANSITOUS_NEARBY_LIMIT=8
TRANSITOUS_CACHE_PATH=data/transitous

# Generic live client (only when TRANSIT_PROVIDER=generic)
TRANSIT_API_BASE_URL=https://example.invalid/api
TRANSIT_API_KEY=

# API server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_DIST_PATH=frontend/dist

# Kiosk browser (deploy/scripts/start-kiosk.sh)
KIOSK_URL=http://127.0.0.1:8000/
# KIOSK_DISPLAY_SERVER=auto          # auto | wayland | x11
# KIOSK_BROWSER=chromium             # chromium | chromium-browser | google-chrome
KIOSK_RESTART_DELAY=3
