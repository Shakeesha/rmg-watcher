[Unit]
Description=rmg-watcher pipeline run
Documentation=file:///opt/rmg-watcher/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=transit
Group=transit
WorkingDirectory=/opt/rmg-watcher
EnvironmentFile=-/opt/rmg-watcher/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rmg-watcher/.venv/bin/rmg-watcher run
TimeoutStartSec=180
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rmg-watcher/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=512M
TasksMax=64
