[Unit]
Description=Transit kiosk GPIO navigation bridge
Documentation=file:///opt/transit-kiosk/README.md
After=multi-user.target
ConditionPathExists=/opt/transit-kiosk/deploy/scripts/gpio_to_keys.py

[Service]
Type=simple
User=transit
Group=transit
SupplementaryGroups=input
WorkingDirectory=/opt/transit-kiosk
EnvironmentFile=-/opt/transit-kiosk/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/transit-kiosk/.venv/bin/python /opt/transit-kiosk/deploy/scripts/gpio_to_keys.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
