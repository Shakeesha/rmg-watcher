[Unit]
Description=rmg-watcher API and kiosk frontend
Documentation=file:///opt/rmg-watcher/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=transit
Group=transit
WorkingDirectory=/opt/rmg-watcher
EnvironmentFile=-/opt/rmg-watcher/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rmg-watcher/.venv/bin/rmg-watcher serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rmg-watcher/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
